{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MdEdit Debug (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-qt-debug/MdEdit.exe",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "CMake: Build Debug"
    },
    {
      "name": "MdEdit Debug (macOS)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/macos-qt-debug/MdEdit.app/Contents/MacOS/MdEdit",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "CMake: Build Debug",
      "preRunCommands": [
        "command script import \"${workspaceFolder}/.vscode/mdedit_lldb.py\""
      ]
    },
    {
      "name": "MdEdit Release (macOS)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/macos-qt-release/MdEdit.app/Contents/MacOS/MdEdit",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "CMake: Build Release",
      "preRunCommands": [
        "command script import \"${workspaceFolder}/.vscode/mdedit_lldb.py\""
      ]
    },
    {
      "name": "MdEdit Debug (Windows / Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/linux-debug/MdEdit",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "CMake: Build Debug",
      "windows": {
        "program": "${workspaceFolder}/build/windows-debug/MdEdit.exe",
        "miDebuggerPath": "gdb.exe",
        "environment": [
          {
            "name": "PATH",
            "value": "${workspaceFolder}/build/windows-deps/vcpkg_installed/x64-mingw-dynamic/debug/bin;${env:PATH}"
          }
        ]
      }
    },
    {
      "name": "MdEdit Release (Windows / Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vcpkg/MdEdit",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "CMake: Build Release",
      "windows": {
        "program": "${workspaceFolder}/build/windows-release/MdEdit.exe",
        "miDebuggerPath": "gdb.exe",
        "environment": [
          {
            "name": "PATH",
            "value": "${workspaceFolder}/build/windows-deps/vcpkg_installed/x64-mingw-dynamic/bin;${env:PATH}"
          }
        ]
      }
    }
  ]
}
