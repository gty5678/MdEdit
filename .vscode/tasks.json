{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "macos-qt-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          ".vscode\\msvc-x64.cmd",
          "cmake",
          "--preset",
          "windows-qt-debug"
        ],
        "problemMatcher": []
      },
      "linux": {
        "args": [
          "--preset",
          "linux-debug"
        ]
      }
    },
    {
      "label": "CMake: Build Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "macos-qt-debug",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: Configure Debug",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          ".vscode\\msvc-x64.cmd",
          "cmake",
          "--build",
          "--preset",
          "windows-qt-debug",
          "--parallel"
        ],
        "problemMatcher": [
          "$msCompile"
        ]
      },
      "linux": {
        "args": [
          "--build",
          "--preset",
          "linux-debug",
          "--parallel"
        ]
      }
    },
    {
      "label": "CMake: Configure Release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "macos-qt-release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          ".vscode\\msvc-x64.cmd",
          "cmake",
          "--preset",
          "windows-qt-release"
        ],
        "problemMatcher": []
      },
      "linux": {
        "args": [
          "--preset",
          "linux-release"
        ]
      }
    },
    {
      "label": "CMake: Build Release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "macos-qt-release",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: Configure Release",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          ".vscode\\msvc-x64.cmd",
          "cmake",
          "--build",
          "--preset",
          "windows-qt-release",
          "--parallel"
        ],
        "problemMatcher": [
          "$msCompile"
        ]
      },
      "linux": {
        "args": [
          "--build",
          "--preset",
          "linux-release",
          "--parallel"
        ]
      }
    },
    {
      "label": "MdEdit: Run without debugger",
      "type": "process",
      "command": "${workspaceFolder}/build/macos-qt-release/MdEdit.app/Contents/MacOS/MdEdit",
      "args": [],
      "dependsOn": "CMake: Build Release",
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/build/windows-qt-release/MdEdit.exe"
      },
      "linux": {
        "command": "${workspaceFolder}/build-vcpkg/MdEdit"
      }
    },
    {
      "label": "MdEdit: Package Windows",
      "type": "shell",
      "command": ".\\build.cmd",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
